# Public Supabase client configuration. These values are embedded in web/APK
# builds and are safe only together with the committed RLS policies.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Legacy projects may use this temporarily instead of the publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Research team contact shown in the consent text (optional, public).
NEXT_PUBLIC_RESEARCH_CONTACT_EMAIL=...

# Never add service-role, secret, database, admin, or AI provider keys here.
