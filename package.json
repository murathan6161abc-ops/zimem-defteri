{
  "name": "zimem-defteri",
  "version": "2.8.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3939",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && node scripts/run-gradle.cjs assembleDebug",
    "android:release": "npm run android:sync && node scripts/run-gradle.cjs assembleRelease",
    "delivery:debug": "npm run android:debug && node scripts/package-apk.cjs",
    "release:key": "node scripts/setup-release-key.cjs",
    "delivery:release": "node scripts/setup-release-key.cjs && npm run android:release && node scripts/package-apk.cjs --release",
    "tarama": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/scan-worker.mjs",
    "tarama:kurulum": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/scan-worker.mjs --kurulum",
    "tarama:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/scan-bench.mjs",
    "tarama:sentetik": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/make-synthetic-ledgers.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@supabase/supabase-js": "2.110.7",
    "next": "16.4.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "uuid": "14.0.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/uuid": "10.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "sharp": "0.35.5",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "postcss": "8.5.31",
    "tar": "7.5.22",
    "zod": "4.6.6",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
